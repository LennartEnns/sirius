+/**
+ * @brief Pack N integer group-by key columns into a single non-nullable INT32 column.
+ *
+ * Each row of the output is: OR((col_i[row] - min_i) << shift_i) for each column i.
+ * The pack plan supplies min_i and shift_i for each column.
+ *
+ * @param input Full input table
+ * @param group_idx Column indices of the group keys within `input`
+ * @param plan Packing metadata (min_val, shift, bits per column)
+ * @param stream CUDA stream
+ * @param mr Device memory resource
+ * @return Single non-nullable INT32 column with one packed key per row
+ */
+[[nodiscard]] std::unique_ptr<cudf::column> pack_group_key_columns(
+  cudf::table_view const& input,
+  std::vector<int> const& group_idx,
+  group_key_pack_plan const& plan,
+  rmm::cuda_stream_view stream,
+  rmm::device_async_resource_ref mr);
+
+/**
+ * @brief Unpack a single INT32 packed key column back into N original key columns.
+ *
+ * Each unpacked column is recovered as: cast((packed >> shift_i) & mask_i + min_i, original_type).
+ * Runs at group cardinality (output of cuDF groupby), not input cardinality.
+ *
+ * @param packed Single INT32 column produced by cuDF groupby from pack_group_key_columns output
+ * @param plan Packing metadata matching the pack step
+ * @param original_types cuDF data types of the original key columns
+ * @param stream CUDA stream
+ * @param mr Device memory resource
+ * @return N columns in group_idx order with original types restored
+ */
+[[nodiscard]] std::vector<std::unique_ptr<cudf::column>> unpack_group_key_column(
+  cudf::column_view const& packed,
+  group_key_pack_plan const& plan,
+  std::vector<cudf::data_type> const& original_types,
+  rmm::cuda_stream_view stream,
+  rmm::device_async_resource_ref mr);
+
+}  // namespace sirius::op::detail
