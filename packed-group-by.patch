+// Extract an int64 value from a scalar of any integer type (host-side read after stream sync).
+static int64_t scalar_as_int64(cudf::scalar const& s, rmm::cuda_stream_view stream)
+{
+  switch (s.type().id()) {
+    case cudf::type_id::INT8:
+      return static_cast<int64_t>(static_cast<cudf::numeric_scalar<int8_t> const&>(s).value(stream));
+    case cudf::type_id::INT16:
+      return static_cast<int64_t>(static_cast<cudf::numeric_scalar<int16_t> const&>(s).value(stream));
+    case cudf::type_id::INT32:
+      return static_cast<int64_t>(static_cast<cudf::numeric_scalar<int32_t> const&>(s).value(stream));
+    case cudf::type_id::INT64:
+      return static_cast<cudf::numeric_scalar<int64_t> const&>(s).value(stream);
+    case cudf::type_id::UINT8:
+      return static_cast<int64_t>(static_cast<cudf::numeric_scalar<uint8_t> const&>(s).value(stream));
+    case cudf::type_id::UINT16:
+      return static_cast<int64_t>(static_cast<cudf::numeric_scalar<uint16_t> const&>(s).value(stream));
+    case cudf::type_id::UINT32:
+      return static_cast<int64_t>(static_cast<cudf::numeric_scalar<uint32_t> const&>(s).value(stream));
+    case cudf::type_id::UINT64: {
+      auto v = static_cast<cudf::numeric_scalar<uint64_t> const&>(s).value(stream);
+      return static_cast<int64_t>(v);  // safe because range <= UINT32_MAX (checked by caller)
+    }
+    default: throw std::runtime_error("scalar_as_int64: unsupported scalar type");
+  }
+}
+
+// Build a pack plan from actual column data when plan-time stats are unavailable.
+// Launches cudf::minmax() per group key column. Skips if any column is non-integer or if
+// total bits exceed 32.
+static std::optional<group_key_pack_plan> try_runtime_pack_plan(
+  cudf::table_view const& input,
+  std::vector<int> const& group_idx,
+  rmm::cuda_stream_view stream,
+  rmm::device_async_resource_ref mr)
+{
+  group_key_pack_plan plan;
+  int32_t total_bits = 0;
+  plan.cols.reserve(group_idx.size());
+
+  for (int idx : group_idx) {
+    auto const col = input.column(idx);
+    auto const tid = col.type().id();
+
+    switch (tid) {
+      case cudf::type_id::INT8:
+      case cudf::type_id::INT16:
+      case cudf::type_id::INT32:
+      case cudf::type_id::INT64:
+      case cudf::type_id::UINT8:
+      case cudf::type_id::UINT16:
+      case cudf::type_id::UINT32:
+      case cudf::type_id::UINT64: break;
+      default: return std::nullopt;
+    }
+
+    auto [min_s, max_s] = cudf::minmax(col, stream, mr);
+    if (!min_s->is_valid(stream) || !max_s->is_valid(stream)) { return std::nullopt; }
+
+    int64_t const min_val = scalar_as_int64(*min_s, stream);
+    int64_t const max_val = scalar_as_int64(*max_s, stream);
+    if (max_val < min_val) { return std::nullopt; }
+
+    uint64_t const range = static_cast<uint64_t>(max_val - min_val);
+    if (range > static_cast<uint64_t>(std::numeric_limits<uint32_t>::max())) {
+      return std::nullopt;
+    }
+
+    int32_t bits   = 0;
+    uint32_t r_tmp = static_cast<uint32_t>(range);
+    while (r_tmp > 0) {
+      r_tmp >>= 1;
+      bits++;
+    }
+
+    total_bits += bits;
+    if (total_bits > 32) { return std::nullopt; }
+
+    group_key_col_meta meta;
+    meta.min_val = min_val;
+    meta.shift   = total_bits - bits;
+    meta.bits    = bits;
+    plan.cols.push_back(meta);
+  }
+
+  plan.total_bits = total_bits;
+  return plan;
+}
