+#include "op/aggregate/pack_group_keys.hpp"
+
+#include <cudf/binaryop.hpp>
+#include <cudf/column/column.hpp>
+#include <cudf/column/column_factories.hpp>
+#include <cudf/column/column_view.hpp>
+#include <cudf/scalar/scalar.hpp>
+#include <cudf/types.hpp>
+#include <cudf/unary.hpp>
+#include <cudf/utilities/error.hpp>
+
+#include <rmm/cuda_stream_view.hpp>
+#include <rmm/device_uvector.hpp>
+#include <rmm/resource_ref.hpp>
+
+#include <algorithm>
+#include <stdexcept>
+
+namespace sirius::op::detail {
+
+namespace {
+
+struct pack_col_desc {
+  uint8_t const* data;  // offset-adjusted base pointer: element i lives at data + i*width
+  int32_t width;        // bytes per element: 1, 2, 4, or 8
+  bool is_signed;       // true for INT8/INT16/INT32/INT64
+  int64_t min_val;      // subtracted from every value before packing
+  int32_t shift;        // left-shift applied after subtraction
+};
+
+__global__ void pack_keys_kernel(pack_col_desc const* __restrict__ cols,
+                                 int ncols,
+                                 int32_t* __restrict__ out,
+                                 cudf::size_type n)
+{
+  auto idx          = static_cast<cudf::size_type>(blockIdx.x) * blockDim.x + threadIdx.x;
+  auto const stride = static_cast<cudf::size_type>(gridDim.x) * blockDim.x;
+  for (; idx < n; idx += stride) {
+    int32_t packed = 0;
+    for (int cc = 0; cc < ncols; ++cc) {
+      pack_col_desc const& d = cols[cc];
+      auto const* base       = d.data + static_cast<ptrdiff_t>(idx) * d.width;
+      int64_t val;
+      if (d.is_signed) {
+        switch (d.width) {
+          case 1: val = static_cast<int64_t>(*reinterpret_cast<int8_t const*>(base)); break;
+          case 2: val = static_cast<int64_t>(*reinterpret_cast<int16_t const*>(base)); break;
+          case 4: val = static_cast<int64_t>(*reinterpret_cast<int32_t const*>(base)); break;
+          default: val = *reinterpret_cast<int64_t const*>(base); break;
+        }
+      } else {
+        switch (d.width) {
+          case 1: val = static_cast<int64_t>(*reinterpret_cast<uint8_t const*>(base)); break;
+          case 2: val = static_cast<int64_t>(*reinterpret_cast<uint16_t const*>(base)); break;
+          case 4: val = static_cast<int64_t>(*reinterpret_cast<uint32_t const*>(base)); break;
+          default:
+            val = static_cast<int64_t>(*reinterpret_cast<uint64_t const*>(base));
+            break;
+        }
+      }
+      packed |= static_cast<int32_t>((val - d.min_val) << d.shift);
+    }
+    out[idx] = packed;
+  }
+}
+
+static dim3 grid_for(cudf::size_type n)
+{
+  constexpr int block_size    = 256;
+  int num_blocks_per_sm       = 0;
+  cudaOccupancyMaxActiveBlocksPerMultiprocessor(
+    &num_blocks_per_sm, pack_keys_kernel, block_size, 0);
+  int device_id = 0;
+  cudaGetDevice(&device_id);
+  int sm_count = 0;
+  cudaDeviceGetAttribute(&sm_count, cudaDevAttrMultiProcessorCount, device_id);
+  auto const resident_blocks = static_cast<cudf::size_type>(num_blocks_per_sm * sm_count);
+  auto const needed_blocks   = (n + block_size - 1) / block_size;
+  return {static_cast<unsigned>(std::min(needed_blocks, resident_blocks))};
+}
+
+}  // namespace
+
+std::unique_ptr<cudf::column> pack_group_key_columns(cudf::table_view const& input,
+                                                     std::vector<int> const& group_idx,
+                                                     group_key_pack_plan const& plan,
+                                                     rmm::cuda_stream_view stream,
+                                                     rmm::device_async_resource_ref mr)
+{
+  CUDF_EXPECTS(!group_idx.empty(), "pack_group_key_columns: group_idx must not be empty");
+  CUDF_EXPECTS(group_idx.size() == plan.cols.size(),
+               "pack_group_key_columns: group_idx and plan.cols size mismatch");
+
+  auto const n = input.num_rows();
+  auto out_col = cudf::make_fixed_width_column(
+    cudf::data_type{cudf::type_id::INT32}, n, cudf::mask_state::UNALLOCATED, stream, mr);
+
+  if (n == 0) { return out_col; }
+
+  auto const ncols = static_cast<int>(group_idx.size());
+  std::vector<pack_col_desc> h_descs(ncols);
+  for (int i = 0; i < ncols; ++i) {
+    auto const col   = input.column(group_idx[i]);
+    auto const& meta = plan.cols[static_cast<size_t>(i)];
+    auto const tid   = col.type().id();
+    int width;
+    bool is_signed;
+    switch (tid) {
+      case cudf::type_id::INT8: width = 1; is_signed = true; break;
+      case cudf::type_id::INT16: width = 2; is_signed = true; break;
+      case cudf::type_id::INT32: width = 4; is_signed = true; break;
+      case cudf::type_id::INT64: width = 8; is_signed = true; break;
+      case cudf::type_id::UINT8: width = 1; is_signed = false; break;
+      case cudf::type_id::UINT16: width = 2; is_signed = false; break;
+      case cudf::type_id::UINT32: width = 4; is_signed = false; break;
+      case cudf::type_id::UINT64: width = 8; is_signed = false; break;
+      default: throw std::runtime_error("pack_group_key_columns: unsupported column type");
+    }
+    h_descs[i].data      = col.head<uint8_t>() + static_cast<ptrdiff_t>(col.offset()) * width;
+    h_descs[i].width     = width;
+    h_descs[i].is_signed = is_signed;
+    h_descs[i].min_val   = meta.min_val;
+    h_descs[i].shift     = meta.shift;
+  }
+
+  rmm::device_uvector<pack_col_desc> d_descs(static_cast<size_t>(ncols), stream, mr);
+  cudaMemcpyAsync(d_descs.data(),
+                  h_descs.data(),
+                  static_cast<size_t>(ncols) * sizeof(pack_col_desc),
+                  cudaMemcpyHostToDevice,
+                  stream.value());
+
+  constexpr int block_size = 256;
+  pack_keys_kernel<<<grid_for(n), block_size, 0, stream.value()>>>(
+    d_descs.data(), ncols, out_col->mutable_view().data<int32_t>(), n);
+
+  return out_col;
+}
+
+std::vector<std::unique_ptr<cudf::column>> unpack_group_key_column(
+  cudf::column_view const& packed,
+  group_key_pack_plan const& plan,
+  std::vector<cudf::data_type> const& original_types,
+  rmm::cuda_stream_view stream,
+  rmm::device_async_resource_ref mr)
+{
+  CUDF_EXPECTS(plan.cols.size() == original_types.size(),
+               "unpack_group_key_column: plan and original_types size mismatch");
+
+  std::vector<std::unique_ptr<cudf::column>> result;
+  result.reserve(plan.cols.size());
+
+  for (size_t i = 0; i < plan.cols.size(); ++i) {
+    auto const& meta = plan.cols[i];
+    int32_t const mask =
+      (meta.bits >= 32) ? ~int32_t{0} : ((int32_t{1} << meta.bits) - int32_t{1});
+
+    // 1. Logical right-shift to position this column's bits at bit 0
+    cudf::numeric_scalar<int32_t> shift_scalar{meta.shift};
+    auto shifted = cudf::binary_operation(packed,
+                                          shift_scalar,
+                                          cudf::binary_operator::SHIFT_RIGHT_UNSIGNED,
+                                          cudf::data_type{cudf::type_id::INT32},
+                                          stream,
+                                          mr);
+
+    // 2. Mask to the allocated bits
+    cudf::numeric_scalar<int32_t> mask_scalar{mask};
+    auto masked = cudf::binary_operation(shifted->view(),
+                                         mask_scalar,
+                                         cudf::binary_operator::BITWISE_AND,
+                                         cudf::data_type{cudf::type_id::INT32},
+                                         stream,
+                                         mr);
+
+    // 3. Upcast to INT64, add min_val, then cast to the original type
+    auto as_int64 =
+      cudf::cast(masked->view(), cudf::data_type{cudf::type_id::INT64}, stream, mr);
+
+    if (meta.min_val != 0) {
+      cudf::numeric_scalar<int64_t> min_scalar{meta.min_val};
+      auto with_min = cudf::binary_operation(as_int64->view(),
+                                              min_scalar,
+                                              cudf::binary_operator::ADD,
+                                              cudf::data_type{cudf::type_id::INT64},
+                                              stream,
+                                              mr);
+      result.push_back(cudf::cast(with_min->view(), original_types[i], stream, mr));
+    } else {
+      result.push_back(cudf::cast(as_int64->view(), original_types[i], stream, mr));
+    }
+  }
+
+  return result;
+}
+
+}  // namespace sirius::op::detail
