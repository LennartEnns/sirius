+static std::optional<sirius::op::group_key_pack_plan> try_group_key_pack_plan(
+  duckdb::LogicalAggregate& op)
+{
+  if (op.groups.empty() || op.grouping_sets.size() > 1 || !op.grouping_functions.empty()) {
+    return std::nullopt;
+  }
+
+  sirius::op::group_key_pack_plan plan;
+  int32_t total_bits = 0;
+  plan.cols.reserve(op.groups.size());
+
+  for (size_t i = 0; i < op.groups.size(); ++i) {
+    auto& group      = op.groups[i];
+    auto& stats      = op.group_stats[i];
+    auto& group_type = group->return_type;
+
+    switch (group_type.InternalType()) {
+      case duckdb::PhysicalType::INT8:
+      case duckdb::PhysicalType::INT16:
+      case duckdb::PhysicalType::INT32:
+      case duckdb::PhysicalType::INT64:
+      case duckdb::PhysicalType::UINT8:
+      case duckdb::PhysicalType::UINT16:
+      case duckdb::PhysicalType::UINT32:
+      case duckdb::PhysicalType::UINT64: break;
+      default: return std::nullopt;
+    }
+
+    if (!stats) {
+      switch (group_type.InternalType()) {
+        case duckdb::PhysicalType::INT8:
+        case duckdb::PhysicalType::INT16:
+        case duckdb::PhysicalType::UINT8:
+        case duckdb::PhysicalType::UINT16:
+          stats = duckdb::NumericStats::CreateUnknown(group_type).ToUnique();
+          duckdb::NumericStats::SetMin(*stats, duckdb::Value::MinimumValue(group_type));
+          duckdb::NumericStats::SetMax(*stats, duckdb::Value::MaximumValue(group_type));
+          break;
+        default: return std::nullopt;
+      }
+    }
+
+    auto& nstats = *stats;
+    if (!duckdb::NumericStats::HasMinMax(nstats)) { return std::nullopt; }
+    if (duckdb::NumericStats::Max(*stats) < duckdb::NumericStats::Min(*stats)) {
+      return std::nullopt;
+    }
+
+    duckdb::hugeint_t range_h;
+    switch (group_type.InternalType()) {
+      case duckdb::PhysicalType::INT8: range_h = get_range_hugeint<int8_t>(nstats); break;
+      case duckdb::PhysicalType::INT16: range_h = get_range_hugeint<int16_t>(nstats); break;
+      case duckdb::PhysicalType::INT32: range_h = get_range_hugeint<int32_t>(nstats); break;
+      case duckdb::PhysicalType::INT64: range_h = get_range_hugeint<int64_t>(nstats); break;
+      case duckdb::PhysicalType::UINT8: range_h = get_range_hugeint<uint8_t>(nstats); break;
+      case duckdb::PhysicalType::UINT16: range_h = get_range_hugeint<uint16_t>(nstats); break;
+      case duckdb::PhysicalType::UINT32: range_h = get_range_hugeint<uint32_t>(nstats); break;
+      case duckdb::PhysicalType::UINT64: range_h = get_range_hugeint<uint64_t>(nstats); break;
+      default: return std::nullopt;
+    }
+
+    uint64_t range;
+    if (!duckdb::Hugeint::TryCast(range_h, range)) { return std::nullopt; }
+    if (range > static_cast<uint64_t>(duckdb::NumericLimits<uint32_t>::Maximum())) {
+      return std::nullopt;
+    }
+
+    int32_t const bits =
+      static_cast<int32_t>(required_bits_for_value(duckdb::UnsafeNumericCast<uint32_t>(range)));
+    total_bits += bits;
+    if (total_bits > 32) { return std::nullopt; }
+
+    int64_t min_val;
+    switch (group_type.InternalType()) {
+      case duckdb::PhysicalType::INT8:
+        min_val = static_cast<int64_t>(duckdb::NumericStats::GetMin<int8_t>(nstats));
+        break;
+      case duckdb::PhysicalType::INT16:
+        min_val = static_cast<int64_t>(duckdb::NumericStats::GetMin<int16_t>(nstats));
+        break;
+      case duckdb::PhysicalType::INT32:
+        min_val = static_cast<int64_t>(duckdb::NumericStats::GetMin<int32_t>(nstats));
+        break;
+      case duckdb::PhysicalType::INT64:
+        min_val = duckdb::NumericStats::GetMin<int64_t>(nstats);
+        break;
+      case duckdb::PhysicalType::UINT8:
+        min_val = static_cast<int64_t>(duckdb::NumericStats::GetMin<uint8_t>(nstats));
+        break;
+      case duckdb::PhysicalType::UINT16:
+        min_val = static_cast<int64_t>(duckdb::NumericStats::GetMin<uint16_t>(nstats));
+        break;
+      case duckdb::PhysicalType::UINT32:
+        min_val = static_cast<int64_t>(duckdb::NumericStats::GetMin<uint32_t>(nstats));
+        break;
+      case duckdb::PhysicalType::UINT64:
+        min_val = static_cast<int64_t>(duckdb::NumericStats::GetMin<uint64_t>(nstats));
+        break;
+      default: return std::nullopt;
+    }
+
+    sirius::op::group_key_col_meta meta;
+    meta.min_val = min_val;
+    meta.shift   = total_bits - bits;  // start-bit position for this column
+    meta.bits    = bits;
+    plan.cols.push_back(meta);
+  }
+
+  plan.total_bits = total_bits;
+  return plan;
+}
