+/**
+ * @brief Per-column packing metadata for group_key_pack_plan.
+ */
+struct group_key_col_meta {
+  int64_t min_val;  ///< Minimum value of the column (subtracted before packing)
+  int32_t shift;    ///< Left-shift applied to (val - min_val) within the packed INT32
+  int32_t bits;     ///< Number of bits allocated to this column in the packed INT32
+};
+
+/**
+ * @brief Plan to bit-pack multiple integer group-by key columns into a single INT32.
+ *
+ * Created at plan time from DuckDB column statistics. Each key column contributes `bits` bits
+ * to the packed value via `(val - min_val) << shift`. The packed INT32 is passed to cuDF
+ * groupby as a single non-nullable fixed-width key (radix-sort path). After groupby, each
+ * original key column is recovered via shift + mask + add.
+ *
+ * Only created when all group key columns are integer types and total_bits <= 32.
+ */
+struct group_key_pack_plan {
+  std::vector<group_key_col_meta> cols;  ///< One entry per group key column, in group_idx order
+  int32_t total_bits{0};                 ///< Sum of all col.bits; always <= 32
+};
+
 }  // namespace op
 }  // namespace sirius
